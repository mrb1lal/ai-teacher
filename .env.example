# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Gemini API Key (get from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Database
DATABASE_PATH=./data/bot.db

# TTS Settings (optional - for audio generation)
# You can use Google Cloud TTS, ElevenLabs, or other TTS services
TTS_PROVIDER=gemini
ELEVENLABS_API_KEY=your_elevenlabs_key_if_using

# Bot Settings
BOT_NAME=AI English Teacher
MAX_IMAGES_PER_MESSAGE=6
MAX_CHAT_HISTORY=100
USER_PROFILE_UPDATE_INTERVAL=3600000

# Logging
LOG_LEVEL=info